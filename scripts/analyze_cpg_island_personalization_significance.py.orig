#!/usr/bin/env python3
# Analyze the default CpG-island-filtered TEST dataset:
#   python3 scripts/analyze_cpg_island_personalization_significance.py
# Analyze a different paired token CSV and output directory:
#   python3 scripts/analyze_cpg_island_personalization_significance.py \
#     --input-file /path/to/paired_tokens.csv.gz \
#     --output-dir scripts/results/custom_cpg_island_significance

from __future__ import annotations

import argparse
import json
from itertools import product
from pathlib import Path

import numpy as np
import pandas as pd


PROJECT = Path(__file__).resolve().parents[1]
DEFAULT_INPUT = (
    PROJECT
    / "cpg_island_filtered_dataset_20260830/outputs/cpg_island_filtered_tokens.csv.gz"
)
DEFAULT_OUTPUT = PROJECT / "cpg_island_filtered_significance_20260830/outputs"
PERMUTATIONS = 10_000
BOOTSTRAPS = 5_000
RANDOM_SEED = 20260830
EXPECTED_ROWS = 2_292_949
EXPECTED_PARTICIPANTS = 31
EXPECTED_E10_F1 = 0.86453009
EXPECTED_E3_F1 = 0.87201631
REQUIRED_COLUMNS = {
    "participant",
    "tissue",
    "window_id",
    "label",
    "predicted_class_e10",
    "predicted_class_e3",
}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Analyze paired E10/E3 predictions already filtered to CpG islands."
    )
    parser.add_argument("--input-file", type=Path, default=DEFAULT_INPUT)
    parser.add_argument("--output-dir", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--permutations", type=int, default=PERMUTATIONS)
    parser.add_argument("--bootstraps", type=int, default=BOOTSTRAPS)
    parser.add_argument("--seed", type=int, default=RANDOM_SEED)
    return parser.parse_args()


def load_tokens(path: Path) -> pd.DataFrame:
    usecols = sorted(REQUIRED_COLUMNS)
    dtypes = {
        "participant": "category",
        "tissue": "category",
        "window_id": "string",
        "label": "int8",
        "predicted_class_e10": "int8",
        "predicted_class_e3": "int8",
    }
    return pd.read_csv(path, usecols=usecols, dtype=dtypes)


def validate_tokens(tokens: pd.DataFrame) -> None:
    missing = REQUIRED_COLUMNS.difference(tokens.columns)
    if missing:
        raise ValueError(f"Missing required columns: {sorted(missing)}")
    if tokens[list(REQUIRED_COLUMNS)].isna().any().any():
        raise ValueError("Filtered dataset contains missing required values")
    for column in ("label", "predicted_class_e10", "predicted_class_e3"):
        values = set(tokens[column].unique())
        if not values.issubset({0, 1, 2}):
            raise ValueError(f"Unexpected classes in {column}: {sorted(values)}")
    participant_tissues = tokens.groupby("participant", observed=True)["tissue"].nunique()
    if not participant_tissues.eq(1).all():
        raise ValueError("A participant occurs in more than one tissue")


def window_confusions(rows: pd.DataFrame) -> tuple[np.ndarray, np.ndarray]:
    window_codes, windows = pd.factorize(rows["window_id"], sort=False)
    e10 = np.zeros((len(windows), 9), dtype=np.int32)
    e3 = np.zeros_like(e10)
    labels = rows["label"].to_numpy(dtype=np.int64)
    e10_cells = labels * 3 + rows["predicted_class_e10"].to_numpy(dtype=np.int64)
    e3_cells = labels * 3 + rows["predicted_class_e3"].to_numpy(dtype=np.int64)
    np.add.at(e10, (window_codes, e10_cells), 1)
    np.add.at(e3, (window_codes, e3_cells), 1)
    return e10, e3


def compress_window_patterns(
    e10: np.ndarray, e3: np.ndarray
) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    patterns, counts = np.unique(
        np.concatenate([e10, e3], axis=1), axis=0, return_counts=True
    )
    return patterns[:, :9], patterns[:, 9:], counts


def safe_divide(numerator: np.ndarray, denominator: np.ndarray) -> np.ndarray:
    output = np.zeros_like(np.asarray(numerator, dtype=float))
    return np.divide(numerator, denominator, out=output, where=denominator != 0)


def weighted_f1(flat_confusions: np.ndarray) -> np.ndarray:
    matrices = np.asarray(flat_confusions, dtype=float).reshape(-1, 3, 3)
    support = matrices.sum(axis=2)
    predicted = matrices.sum(axis=1)
    true_positive = np.diagonal(matrices, axis1=1, axis2=2)
    precision = safe_divide(true_positive, predicted)
    recall = safe_divide(true_positive, support)
    class_f1 = safe_divide(2 * precision * recall, precision + recall)
    return safe_divide((class_f1 * support).sum(axis=1), support.sum(axis=1))


def observed_f1(e10: np.ndarray, e3: np.ndarray) -> tuple[float, float]:
    e10_f1 = weighted_f1(e10.sum(axis=0, keepdims=True))[0]
    e3_f1 = weighted_f1(e3.sum(axis=0, keepdims=True))[0]
    return float(e10_f1), float(e3_f1)


def permutation_deltas(
    e10_patterns: np.ndarray,
    e3_patterns: np.ndarray,
    counts: np.ndarray,
    repetitions: int,
    rng: np.random.Generator,
) -> np.ndarray:
    output = np.empty(repetitions)
    e10_total = counts @ e10_patterns
    e3_total = counts @ e3_patterns
    pattern_difference = e10_patterns - e3_patterns
    for start in range(0, repetitions, 250):
        stop = min(start + 250, repetitions)
        swapped = rng.binomial(
            counts, 0.5, size=(stop - start, len(counts))
        )
        adjustment = swapped @ pattern_difference
        permuted_e3 = e3_total + adjustment
        permuted_e10 = e10_total - adjustment
        output[start:stop] = weighted_f1(permuted_e3) - weighted_f1(permuted_e10)
    return output


def bootstrap_deltas(
    e10_patterns: np.ndarray,
    e3_patterns: np.ndarray,
    counts: np.ndarray,
    repetitions: int,
    rng: np.random.Generator,
) -> np.ndarray:
    output = np.empty(repetitions)
    window_count = int(counts.sum())
    probabilities = counts / window_count
    for start in range(0, repetitions, 250):
        stop = min(start + 250, repetitions)
        sampled = rng.multinomial(
            window_count, probabilities, size=stop - start
        )
        sampled_e10 = sampled @ e10_patterns
        sampled_e3 = sampled @ e3_patterns
        output[start:stop] = weighted_f1(sampled_e3) - weighted_f1(sampled_e10)
    return output


def monte_carlo_p(null_values: np.ndarray, observed: float) -> float:
    exceedances = int(np.count_nonzero(null_values >= observed))
    return (exceedances + 1) / (len(null_values) + 1)


def relative_improvement(e10_f1: float, e3_f1: float) -> float:
    return 100 * (e3_f1 - e10_f1) / e10_f1


def analyze_participant(
    participant: str,
    rows: pd.DataFrame,
    permutations: int,
    bootstraps: int,
    seed: int,
) -> dict[str, object]:
    e10, e3 = window_confusions(rows)
    e10_patterns, e3_patterns, counts = compress_window_patterns(e10, e3)
    e10_f1, e3_f1 = observed_f1(e10, e3)
    delta = e3_f1 - e10_f1
    rng = np.random.default_rng(seed)
    permutation = permutation_deltas(
        e10_patterns, e3_patterns, counts, permutations, rng
    )
    bootstrap = bootstrap_deltas(
        e10_patterns, e3_patterns, counts, bootstraps, rng
    )
    return {
        "participant": participant,
        "tissue": str(rows["tissue"].iloc[0]),
        "tokens": len(rows),
        "windows": len(e10),
        "compressed_window_patterns": len(counts),
        "e10_weighted_f1": e10_f1,
        "e3_weighted_f1": e3_f1,
        "delta_e3_minus_e10": delta,
        "relative_improvement_percent": relative_improvement(e10_f1, e3_f1),
        "bootstrap_ci_low": float(np.quantile(bootstrap, 0.025)),
        "bootstrap_ci_high": float(np.quantile(bootstrap, 0.975)),
        "permutation_p_one_sided": monte_carlo_p(permutation, delta),
    }


def benjamini_hochberg(values: pd.Series) -> pd.Series:
    result = pd.Series(np.nan, index=values.index, dtype=float)
    valid = values.dropna().sort_values()
    ranks = np.arange(1, len(valid) + 1)
    adjusted = valid.to_numpy() * len(valid) / ranks
    adjusted = np.minimum.accumulate(adjusted[::-1])[::-1]
    result.loc[valid.index] = np.minimum(adjusted, 1.0)
    return result


def analyze_people(tokens: pd.DataFrame, args: argparse.Namespace) -> pd.DataFrame:
    records = []
    grouped = tokens.groupby("participant", observed=True, sort=True)
    for index, (participant, rows) in enumerate(grouped):
        print(f"Analyzing {participant} ({index + 1}/{tokens['participant'].nunique()})", flush=True)
        records.append(
            analyze_participant(
                str(participant),
                rows,
                args.permutations,
                args.bootstraps,
                args.seed + index,
            )
        )
    people = pd.DataFrame(records)
    people["permutation_q_bh_31_tests"] = benjamini_hochberg(
        people["permutation_p_one_sided"]
    )
    people["significantly_improved"] = (
        people["delta_e3_minus_e10"].gt(0)
        & people["permutation_q_bh_31_tests"].lt(0.05)
    )
    people["direction"] = np.select(
        [people["delta_e3_minus_e10"].gt(0), people["delta_e3_minus_e10"].lt(0)],
        ["improved", "worsened"],
        default="tied",
    )
    return people


def exact_sign_flip_p(differences: np.ndarray) -> float:
    observed = float(differences.mean())
    signs = np.asarray(list(product([-1.0, 1.0], repeat=len(differences))))
    null_values = (signs * differences).mean(axis=1)
    return float(np.mean(null_values >= observed))


def bootstrap_mean(
    differences: np.ndarray, repetitions: int, rng: np.random.Generator
) -> np.ndarray:
    indices = rng.integers(0, len(differences), size=(repetitions, len(differences)))
    return differences[indices].mean(axis=1)


def tissue_summary(
    people: pd.DataFrame, bootstraps: int, seed: int
) -> pd.DataFrame:
    records = []
    for index, (tissue, rows) in enumerate(people.groupby("tissue", sort=True)):
        differences = rows["delta_e3_minus_e10"].to_numpy(dtype=float)
        bootstrap = bootstrap_mean(
            differences, bootstraps, np.random.default_rng(seed + index)
        )
        e10_f1 = float(rows["e10_weighted_f1"].mean())
        e3_f1 = float(rows["e3_weighted_f1"].mean())
        records.append(
            {
                "tissue": tissue,
                "participants": len(rows),
                "tokens": int(rows["tokens"].sum()),
                "person_windows": int(rows["windows"].sum()),
                "e10_weighted_f1": e10_f1,
                "e3_weighted_f1": e3_f1,
                "delta_e3_minus_e10": float(differences.mean()),
                "relative_improvement_percent": relative_improvement(e10_f1, e3_f1),
                "bootstrap_ci_low": float(np.quantile(bootstrap, 0.025)),
                "bootstrap_ci_high": float(np.quantile(bootstrap, 0.975)),
                "exact_permutation_p_one_sided": exact_sign_flip_p(differences),
                "improved_participants": int(rows["direction"].eq("improved").sum()),
                "worsened_participants": int(rows["direction"].eq("worsened").sum()),
                "significantly_improved_participants": int(
                    rows["significantly_improved"].sum()
                ),
            }
        )
    tissues = pd.DataFrame(records)
    tissues["permutation_q_bh_6_tests"] = benjamini_hochberg(
        tissues["exact_permutation_p_one_sided"]
    )
    return tissues


def equal_tissue_statistic(people: pd.DataFrame, column: str) -> float:
    return float(people.groupby("tissue")[column].mean().mean())


def combined_null(
    people: pd.DataFrame,
    repetitions: int,
    rng: np.random.Generator,
    equal_tissue: bool,
) -> np.ndarray:
    differences = people["delta_e3_minus_e10"].to_numpy(dtype=float)
    signs = rng.choice([-1.0, 1.0], size=(repetitions, len(people)))
    signed = signs * differences
    if not equal_tissue:
        return signed.mean(axis=1)
    tissue_codes, tissues = pd.factorize(people["tissue"], sort=True)
    tissue_means = np.column_stack(
        [signed[:, tissue_codes == index].mean(axis=1) for index in range(len(tissues))]
    )
    return tissue_means.mean(axis=1)


def combined_bootstrap(
    people: pd.DataFrame,
    repetitions: int,
    rng: np.random.Generator,
    equal_tissue: bool,
) -> np.ndarray:
    differences = people["delta_e3_minus_e10"].to_numpy(dtype=float)
    if not equal_tissue:
        return bootstrap_mean(differences, repetitions, rng)
    tissue_values = [
        rows["delta_e3_minus_e10"].to_numpy(dtype=float)
        for _, rows in people.groupby("tissue", sort=True)
    ]
    output = np.empty(repetitions)
    for repetition in range(repetitions):
        means = []
        for values in tissue_values:
            selected = rng.integers(0, len(values), size=len(values))
            means.append(values[selected].mean())
        output[repetition] = np.mean(means)
    return output


def combined_summary(
    people: pd.DataFrame, permutations: int, bootstraps: int, seed: int
) -> pd.DataFrame:
    records = []
    for index, equal_tissue in enumerate((True, False)):
        weighting = "equal_tissue" if equal_tissue else "equal_person"
        if equal_tissue:
            e10_f1 = equal_tissue_statistic(people, "e10_weighted_f1")
            e3_f1 = equal_tissue_statistic(people, "e3_weighted_f1")
        else:
            e10_f1 = float(people["e10_weighted_f1"].mean())
            e3_f1 = float(people["e3_weighted_f1"].mean())
        observed = e3_f1 - e10_f1
        rng = np.random.default_rng(seed + index)
        null_values = combined_null(people, permutations, rng, equal_tissue)
        bootstrap = combined_bootstrap(people, bootstraps, rng, equal_tissue)
        records.append(
            {
                "weighting": weighting,
                "participants": len(people),
                "tissues": people["tissue"].nunique(),
                "tokens": int(people["tokens"].sum()),
                "person_windows": int(people["windows"].sum()),
                "e10_weighted_f1": e10_f1,
                "e3_weighted_f1": e3_f1,
                "delta_e3_minus_e10": observed,
                "relative_improvement_percent": relative_improvement(e10_f1, e3_f1),
                "bootstrap_ci_low": float(np.quantile(bootstrap, 0.025)),
                "bootstrap_ci_high": float(np.quantile(bootstrap, 0.975)),
                "permutation_p_one_sided": monte_carlo_p(null_values, observed),
                "improved_participants": int(people["direction"].eq("improved").sum()),
                "worsened_participants": int(people["direction"].eq("worsened").sum()),
            }
        )
    return pd.DataFrame(records)


def validate_documented_results(people: pd.DataFrame) -> None:
    e10 = float(people["e10_weighted_f1"].mean())
    e3 = float(people["e3_weighted_f1"].mean())
    improved = int(people["direction"].eq("improved").sum())
    if len(people) != EXPECTED_PARTICIPANTS:
        raise ValueError(f"Expected {EXPECTED_PARTICIPANTS} participants, found {len(people)}")
    if not np.isclose(e10, EXPECTED_E10_F1, atol=5e-8):
        raise ValueError(f"E10 QC mismatch: {e10}")
    if not np.isclose(e3, EXPECTED_E3_F1, atol=5e-8):
        raise ValueError(f"E3 QC mismatch: {e3}")
    if improved != 22:
        raise ValueError(f"Direction QC mismatch: expected 22 improved, found {improved}")


def number(value: float, digits: int = 6) -> str:
    return f"{value:.{digits}f}"


def markdown_table(headers: list[str], rows: list[list[str]]) -> list[str]:
    lines = ["| " + " | ".join(headers) + " |"]
    lines.append("|" + "|".join("---" for _ in headers) + "|")
    lines.extend("| " + " | ".join(row) + " |" for row in rows)
    return lines


def combined_table(combined: pd.DataFrame) -> list[str]:
    rows = []
    for result in combined.itertuples(index=False):
        rows.append(
            [
                result.weighting.replace("_", " ").title(),
                number(result.e10_weighted_f1),
                number(result.e3_weighted_f1),
                number(result.delta_e3_minus_e10),
                number(result.relative_improvement_percent, 2),
                f"{number(result.bootstrap_ci_low)} to {number(result.bootstrap_ci_high)}",
                number(result.permutation_p_one_sided),
                f"{result.improved_participants}/{result.participants}",
            ]
        )
    return markdown_table(
        [
            "Weighting",
            "E10 F1",
            "E3 F1",
            "Delta F1",
            "Relative improvement (%)",
            "95% CI",
            "One-sided p",
            "Participants improved",
        ],
        rows,
    )


def tissue_table(tissues: pd.DataFrame) -> list[str]:
    rows = []
    for result in tissues.sort_values("tissue").itertuples(index=False):
        rows.append(
            [
                result.tissue,
                str(result.participants),
                f"{result.improved_participants}/{result.participants}",
                f"{result.significantly_improved_participants}/{result.participants}",
                number(result.e10_weighted_f1),
                number(result.e3_weighted_f1),
                number(result.delta_e3_minus_e10),
                number(result.relative_improvement_percent, 2),
                f"{number(result.bootstrap_ci_low)} to {number(result.bootstrap_ci_high)}",
                number(result.exact_permutation_p_one_sided),
                number(result.permutation_q_bh_6_tests),
            ]
        )
    return markdown_table(
        [
            "Tissue",
            "Participants",
            "Improved",
            "Significantly improved",
            "E10 F1",
            "E3 F1",
            "Delta F1",
            "Relative improvement (%)",
            "95% CI",
            "One-sided p",
            "BH q (6 tissues)",
        ],
        rows,
    )


def person_table(people: pd.DataFrame) -> list[str]:
    rows = []
    for result in people.sort_values(["tissue", "participant"]).itertuples(index=False):
        rows.append(
            [
                result.tissue,
                result.participant,
                f"{result.tokens:,}",
                f"{result.windows:,}",
                number(result.e10_weighted_f1),
                number(result.e3_weighted_f1),
                number(result.delta_e3_minus_e10),
                number(result.relative_improvement_percent, 2),
                f"{number(result.bootstrap_ci_low)} to {number(result.bootstrap_ci_high)}",
                number(result.permutation_p_one_sided),
                number(result.permutation_q_bh_31_tests),
                "yes" if result.significantly_improved else "no",
            ]
        )
    return markdown_table(
        [
            "Tissue",
            "Participant",
            "Tokens",
            "Windows",
            "E10 F1",
            "E3 F1",
            "Delta F1",
            "Relative improvement (%)",
            "95% CI",
            "One-sided p",
            "BH q (31 participants)",
            "Significantly improved",
        ],
        rows,
    )


def report_text(
    input_file: Path,
    people: pd.DataFrame,
    tissues: pd.DataFrame,
    combined: pd.DataFrame,
    args: argparse.Namespace,
) -> str:
    significant = int(people["significantly_improved"].sum())
    lines = [
        "# CpG-island-filtered TEST personalization significance analysis",
        "",
        "## Scope",
        "",
        f"- Input: `{input_file}`.",
        "- The saved CpG-island-filtered dataset was used directly; genomic filtering was not repeated.",
        "- Comparison: personalized E3 versus donor-specific pretrained/LODO E10.",
        "- Outcome: K=3 class-support-weighted F1 on paired TEST tokens.",
        "- Directional hypothesis: E3 improves weighted F1 over E10.",
        f"- Resampling: {args.permutations:,} one-sided permutations and {args.bootstraps:,} bootstrap replicates.",
        "- All p-values are exploratory/nominal because the CpG-island subset and observed direction were inspected before this analysis; they are not newly prespecified confirmatory tests.",
        "- This analysis tests E3 versus E10 within CpG-island-overlapping tokens. It does not itself test whether the personalization effect differs from unfiltered TEST tokens.",
        "",
        "## Methods",
        "",
        "### Participant-level analysis",
        "",
        "For each participant, paired rows were grouped by `window_id`. Separate 3x3 E10 and E3 confusion matrices were built for every window. "
        "Observed weighted F1 was calculated after summing all window confusion matrices; window-level F1 values were not averaged. In each permutation, "
        "the complete E10/E3 confusion contribution was retained or swapped independently for every window, weighted F1 was recomputed, and the one-sided "
        "null difference was recorded. The p-value is `(1 + null >= observed) / (permutations + 1)`. The 95% CI resampled paired windows with replacement.",
        "",
        "Identical joint window-confusion patterns were compressed for computation. Independent swap counts were sampled binomially for each pattern, and "
        "bootstrap pattern counts were sampled multinomially. This is distributionally equivalent to independently swapping or resampling every original window.",
        "",
        "Participant p-values are exploratory because nearby or overlapping windows may be spatially dependent. BH q-values correct the 31 participant tests. "
        "A participant is counted as significantly improved only when Delta F1 is positive and `q < 0.05`.",
        "",
        "### Combined analyses",
        "",
        "The equal-tissue statistic first averages participant effects within tissue and then averages the six tissue means, so every tissue receives one sixth "
        "of the total weight. The equal-person sensitivity statistic is the simple mean of all 31 participant effects. Both use paired participant-level label "
        "swaps, with people as the independent biological units. Bootstrap CIs resample people within tissue for equal-tissue weighting and across the full "
        "cohort for equal-person weighting.",
        "",
        "### Tissue analyses",
        "",
        "Within each tissue, all `2^n` sign assignments of participant-level effects were enumerated exactly. Participants receive equal weight within tissue. "
        "BH q-values correct the six tissue tests. These results are exploratory and low-powered because tissues contain only 4-8 participants.",
        "",
        "### Interpretation limits",
        "",
        "CpG-island overlap identifies a genomic annotation subset; it does not establish regulatory function, mechanism, or behavior of individual CpG cytosines. "
        "The rows represent documented six-base prediction tokens, and `token_start` need not be an individual CpG coordinate. Effect sizes and participant "
        "directions should be emphasized alongside p-values.",
        "",
        "## Combined results",
        "",
        *combined_table(combined),
        "",
        "## Tissue results",
        "",
        "`Significantly improved` counts use participant-level BH q-values across all 31 participants, not the tissue-level q-value.",
        "",
        *tissue_table(tissues),
        "",
        "## Participant results",
        "",
        *person_table(people),
        "",
        "## Summary",
        "",
        f"E3 improved weighted F1 for {int(people['direction'].eq('improved').sum())}/31 participants and worsened it for "
        f"{int(people['direction'].eq('worsened').sum())}/31. After exploratory BH correction across participants, "
        f"{significant}/31 had a positive effect with q < 0.05.",
        "",
        "The combined participant-level analyses are more defensible for cohort claims than the within-participant window p-values because people, rather than "
        "tokens or windows, are treated as the biological replication units. The CpG-island-minus-unfiltered interaction remains a separate paired analysis.",
    ]
    return "\n".join(lines) + "\n"


def save_outputs(
    output_dir: Path,
    input_file: Path,
    people: pd.DataFrame,
    tissues: pd.DataFrame,
    combined: pd.DataFrame,
    args: argparse.Namespace,
) -> None:
    output_dir.mkdir(parents=True, exist_ok=True)
    people.to_csv(output_dir / "participant_results.csv", index=False)
    tissues.to_csv(output_dir / "tissue_results.csv", index=False)
    combined.to_csv(output_dir / "combined_results.csv", index=False)
    report = report_text(input_file, people, tissues, combined, args)
    (output_dir / "REPORT.md").write_text(report, encoding="utf-8")
    metadata = {
        "input_file": str(input_file.resolve()),
        "rows": int(people["tokens"].sum()),
        "participants": len(people),
        "tissues": int(people["tissue"].nunique()),
        "person_windows": int(people["windows"].sum()),
        "permutations": args.permutations,
        "bootstraps": args.bootstraps,
        "seed": args.seed,
        "filtering_repeated": False,
        "directional_hypothesis": "E3 weighted F1 > E10 weighted F1",
    }
    (output_dir / "RUN_METADATA.json").write_text(
        json.dumps(metadata, indent=2) + "\n", encoding="utf-8"
    )


def main() -> None:
    args = parse_args()
    tokens = load_tokens(args.input_file)
    validate_tokens(tokens)
    if args.input_file.resolve() == DEFAULT_INPUT.resolve() and len(tokens) != EXPECTED_ROWS:
        raise ValueError(f"Expected {EXPECTED_ROWS:,} rows, found {len(tokens):,}")
    people = analyze_people(tokens, args)
    if args.input_file.resolve() == DEFAULT_INPUT.resolve():
        validate_documented_results(people)
    tissues = tissue_summary(people, args.bootstraps, args.seed + 10_000)
    combined = combined_summary(
        people, args.permutations, args.bootstraps, args.seed + 20_000
    )
    save_outputs(args.output_dir, args.input_file, people, tissues, combined, args)
    print(f"Wrote {args.output_dir}", flush=True)


if __name__ == "__main__":
    main()
