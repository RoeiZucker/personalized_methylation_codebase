#!/usr/bin/env python3
# Build reusable standard-row caches and all annotation reports:
#   python3 scripts/create_annotation_standard_reports.py --workers 2
# Build or resume only the reusable participant caches:
#   python3 scripts/create_annotation_standard_reports.py --cache-only --workers 2
# Build selected reports from completed caches:
#   python3 scripts/create_annotation_standard_reports.py --reports-only --annotations cpg_shore promoter
# Rebuild selected reports from saved metric tables without rereading token datasets:
#   python3 scripts/create_annotation_standard_reports.py --pdf-only --annotations cpg_shore promoter
# Build chromosome 12 reports from the saved chr12 annotation datasets:
#   python3 scripts/create_annotation_standard_reports.py \
#     --analysis-dir chr12_annotation_f1_analysis_20260830/outputs \
#     --output-dir chr12_annotation_standard_reports_20260831/outputs \
#     --standard-root scripts/results/downsampled_standard_ratio_0p25_lr_3e-05_chr12_standardized_split_v1 \
#     --variability-root /sci/labs/michall/roeizucker/huggingface_datasets_dir/huggingface_datasets_dir_chr12_standardized_split_v1 \
#     --scope-label "chromosome 12" --workers 2

from __future__ import annotations

import argparse
from collections import defaultdict
from concurrent.futures import ProcessPoolExecutor, as_completed
from dataclasses import dataclass
import json
from pathlib import Path
import sys

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.backends.backend_pdf import PdfPages
import numpy as np
import pandas as pd

PROJECT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT))
sys.path.insert(0, str(PROJECT / "src"))

from create_cpg_island_standard_report import (
    SECTIONS,
    aggregate,
    discover_tasks,
    draw_result_page,
    extract_prediction,
)


ANALYSIS = PROJECT / "other_annotation_f1_analysis_20260830/outputs"
OUTPUT = PROJECT / "other_annotation_standard_reports_20260830/outputs"
STANDARD_ROOT = PROJECT / "scripts/results/downsampled_standard_ratio_0p25_lr_3e-05"
VARIABILITY_ROOT = Path(
    "/sci/labs/michall/roeizucker/huggingface_datasets_dir/huggingface_datasets_dir"
)
MODEL_COLUMNS = {
    "pretrain": "predicted_class_e10",
    "E1": "predicted_class_e1",
    "E2": "predicted_class_e2",
    "E3": "predicted_class_e3",
    "mean_label": "mean_label",
}


@dataclass(frozen=True)
class CacheSettings:
    cache_dir: str
    chunksize: int
    force: bool


@dataclass(frozen=True)
class DatasetSpec:
    name: str
    path: Path
    rows: int
    rule: str


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Create standard TEST weighted-F1 reports for saved annotation-filtered tokens."
    )
    parser.add_argument("--analysis-dir", type=Path, default=ANALYSIS)
    parser.add_argument("--output-dir", type=Path, default=OUTPUT)
    parser.add_argument("--standard-root", type=Path, default=STANDARD_ROOT)
    parser.add_argument("--variability-root", type=Path, default=VARIABILITY_ROOT)
    parser.add_argument("--annotations", nargs="+")
    parser.add_argument("--participant")
    parser.add_argument(
        "--scope-label",
        default="ordinary",
        help="Genomic scope shown in report titles, for example 'chromosome 12'.",
    )
    parser.add_argument("--workers", type=int, default=2)
    parser.add_argument("--chunksize", type=int, default=400_000)
    parser.add_argument("--force-cache", action="store_true")
    parser.add_argument("--cache-only", action="store_true")
    parser.add_argument("--reports-only", action="store_true")
    parser.add_argument("--pdf-only", action="store_true")
    return parser.parse_args()


def validate_args(args: argparse.Namespace) -> None:
    if args.workers < 1 or args.chunksize < 1:
        raise ValueError("--workers and --chunksize must be positive")
    modes = sum([args.cache_only, args.reports_only, args.pdf_only])
    if modes > 1:
        raise ValueError("Choose at most one of --cache-only, --reports-only, and --pdf-only")
    if args.participant and not args.cache_only:
        raise ValueError("--participant is supported only with --cache-only")


def dataset_specs(analysis_dir: Path, selected: list[str] | None) -> list[DatasetSpec]:
    metadata = json.loads((analysis_dir / "METADATA.json").read_text(encoding="utf-8"))
    requested = set(selected or [])
    available = {item["filter"] for item in metadata["datasets"]}
    missing = requested - available
    if missing:
        raise ValueError(f"Unknown annotations: {sorted(missing)}")
    specs = []
    for item in metadata["datasets"]:
        if requested and item["filter"] not in requested:
            continue
        path = Path(item["path"])
        if not path.exists():
            path = analysis_dir / "datasets" / path.name
        if not path.exists():
            raise FileNotFoundError(path)
        specs.append(DatasetSpec(item["filter"], path, int(item["rows"]), item["rule"]))
    return specs


def cache_path(cache_dir: Path, participant: str) -> Path:
    return cache_dir / f"{participant}_standard_rows.pkl.gz"


def cache_metadata_path(cache_dir: Path, participant: str) -> Path:
    return cache_dir / f"{participant}_metadata.json"


def load_variability(path: str) -> tuple[dict[str, pd.Series], float]:
    from src.evaluator import create_variability_std_lookup

    rows = pd.read_csv(path, usecols=["full_position", "std"])
    maximum = float(pd.to_numeric(rows["std"], errors="coerce").max())
    return create_variability_std_lookup(rows), maximum


def assign_sections(rows: pd.DataFrame, lookup: dict[str, pd.Series], maximum: float) -> pd.Series:
    from src.evaluator import create_variability_std_values

    values = create_variability_std_values(rows, lookup)
    edges = np.linspace(0.0, maximum, 6)
    sections = pd.cut(
        values,
        bins=edges,
        labels=SECTIONS[1:],
        include_lowest=True,
        right=True,
    )
    if sections.isna().any():
        raise ValueError(f"{int(sections.isna().sum()):,} standard rows lack variability bins")
    return sections


def load_mean_rows(path: str) -> pd.DataFrame:
    columns = ["window_id", "genomic_position", "label", "chrom", "mean_label"]
    rows = pd.read_pickle(path)[columns].copy()
    rows["label"] = rows["label"].astype("int8")
    rows["mean_label"] = rows["mean_label"].astype("int8")
    rows["row_id"] = np.arange(len(rows), dtype=np.int64)
    keys = ["window_id", "genomic_position", "label"]
    if rows.duplicated(keys).any():
        raise ValueError("Mean-label cache contains duplicate prediction keys")
    return rows


def compact_cache(rows: pd.DataFrame) -> pd.DataFrame:
    columns = [
        "window_id",
        "genomic_position",
        "label",
        "mean_label",
        "section_rank",
        "predicted_class_e1",
        "predicted_class_e2",
    ]
    result = rows[columns].copy()
    for column in ["label", "mean_label", "predicted_class_e1", "predicted_class_e2"]:
        result[column] = result[column].astype("int8")
    result["section_rank"] = result["section_rank"].astype("category")
    return result


def build_cache(task, settings: CacheSettings) -> str:
    directory = Path(settings.cache_dir)
    path = cache_path(directory, task.participant)
    metadata_path = cache_metadata_path(directory, task.participant)
    if path.exists() and metadata_path.exists() and not settings.force:
        return f"reuse cache {task.participant}"
    rows = load_mean_rows(task.mean_cache_path)
    lookup, maximum = load_variability(task.variability_path)
    rows["section_rank"] = assign_sections(rows, lookup, maximum)
    del lookup
    rows["predicted_class_e1"] = extract_prediction(
        rows, task.e1_path, settings.chunksize
    ).to_numpy()
    rows["predicted_class_e2"] = extract_prediction(
        rows, task.e2_path, settings.chunksize
    ).to_numpy()
    result = compact_cache(rows)
    path.parent.mkdir(parents=True, exist_ok=True)
    result.to_pickle(path, compression="gzip")
    metadata_path.write_text(
        json.dumps(
            {
                "participant": task.participant,
                "tissue": task.tissue,
                "rows": len(result),
                "variability_std_max": maximum,
                "e1_path": task.e1_path,
                "e2_path": task.e2_path,
                "mean_cache_path": task.mean_cache_path,
                "variability_path": task.variability_path,
            },
            indent=2,
        ),
        encoding="utf-8",
    )
    return f"complete cache {task.participant}: {len(result):,} rows"


def build_caches(tasks: list, settings: CacheSettings, workers: int) -> None:
    if workers == 1:
        for task in tasks:
            print(build_cache(task, settings), flush=True)
        return
    with ProcessPoolExecutor(max_workers=workers) as executor:
        futures = {executor.submit(build_cache, task, settings): task for task in tasks}
        for future in as_completed(futures):
            print(future.result(), flush=True)


def confusion(labels: np.ndarray, predictions: np.ndarray) -> np.ndarray:
    return np.bincount(3 * labels + predictions, minlength=9).reshape(3, 3)


def empty_matrices() -> dict[str, dict[str, np.ndarray]]:
    return {
        section: {name: np.zeros((3, 3), dtype=np.int64) for name in MODEL_COLUMNS}
        for section in SECTIONS
    }


def weighted_f1(matrix: np.ndarray) -> float:
    support = matrix.sum(axis=1).astype(float)
    if support.sum() == 0:
        return float("nan")
    predicted = matrix.sum(axis=0).astype(float)
    true_positive = np.diag(matrix).astype(float)
    precision = np.divide(true_positive, predicted, out=np.zeros(3), where=predicted > 0)
    recall = np.divide(true_positive, support, out=np.zeros(3), where=support > 0)
    class_f1 = np.divide(
        2 * precision * recall,
        precision + recall,
        out=np.zeros(3),
        where=(precision + recall) > 0,
    )
    return float(np.average(class_f1, weights=support))


def load_cache(cache_dir: Path, participant: str) -> pd.DataFrame:
    path = cache_path(cache_dir, participant)
    if not path.exists():
        raise FileNotFoundError(f"Missing standard-row cache: {path}")
    return pd.read_pickle(path, compression="gzip")


def add_section_rows(matrices: dict, rows: pd.DataFrame, section: str) -> None:
    subset = rows if section == "all_results" else rows.loc[rows["section_rank"].eq(section)]
    if subset.empty:
        return
    labels = subset["label"].to_numpy(dtype=np.int64)
    for name, column in MODEL_COLUMNS.items():
        predictions = subset[column].to_numpy(dtype=np.int64)
        matrices[section][name] += confusion(labels, predictions)


def merge_standard_rows(rows: pd.DataFrame, cache: pd.DataFrame) -> pd.DataFrame:
    rows = rows.copy()
    rows["label"] = rows["label"].astype("int8")
    rows["genomic_position"] = rows["token_start"].astype("int64")
    keys = ["window_id", "genomic_position", "label"]
    return rows.merge(cache, on=keys, how="inner", validate="one_to_one")


def analyze_dataset(
    spec: DatasetSpec,
    tasks_by_participant: dict,
    cache_dir: Path,
    chunksize: int,
) -> tuple[pd.DataFrame, pd.DataFrame]:
    matrices = defaultdict(empty_matrices)
    filtered_counts = defaultdict(int)
    standard_counts = defaultdict(int)
    active_participant = None
    active_cache = None
    columns = [
        "participant",
        "tissue",
        "window_id",
        "token_start",
        "label",
        "predicted_class_e10",
        "predicted_class_e3",
    ]
    for chunk in pd.read_csv(spec.path, usecols=columns, chunksize=chunksize):
        for participant, rows in chunk.groupby("participant", sort=False):
            if participant not in tasks_by_participant:
                raise ValueError(f"{spec.name}: unexpected participant {participant}")
            if active_participant != participant:
                active_cache = load_cache(cache_dir, participant)
                active_participant = participant
            filtered_counts[participant] += len(rows)
            selected = merge_standard_rows(rows, active_cache)
            standard_counts[participant] += len(selected)
            for section in SECTIONS:
                add_section_rows(matrices[participant], selected, section)
    return dataset_tables(
        spec, tasks_by_participant, matrices, filtered_counts, standard_counts
    )


def metric_record(task, section: str, model: str, matrix: np.ndarray) -> dict:
    stage = "pretrain" if model in {"pretrain", "mean_label"} else model
    prediction_type = "mean_label" if model == "mean_label" else "predicted_class"
    return {
        "sample": task.participant,
        "tissue": task.tissue,
        "split": "test",
        "stage": stage,
        "prediction_type": prediction_type,
        "section_rank": section,
        "support": int(matrix.sum()),
        "weighted_f1": weighted_f1(matrix),
    }


def dataset_tables(spec, tasks, matrices, filtered_counts, standard_counts):
    metrics = []
    coverage = []
    for participant, task in sorted(tasks.items()):
        filtered = filtered_counts[participant]
        standard = standard_counts[participant]
        if filtered == 0:
            raise ValueError(f"{spec.name}: no rows for {participant}")
        for section in SECTIONS:
            for model in MODEL_COLUMNS:
                metrics.append(metric_record(task, section, model, matrices[participant][section][model]))
        coverage.append(
            {
                "sample": participant,
                "tissue": task.tissue,
                "filtered_tokens": filtered,
                "standard_evaluable_filtered_tokens": standard,
                "coverage_fraction": standard / filtered,
            }
        )
    if sum(filtered_counts.values()) != spec.rows:
        raise ValueError(
            f"{spec.name}: read {sum(filtered_counts.values()):,} rows, expected {spec.rows:,}"
        )
    return pd.DataFrame(metrics), pd.DataFrame(coverage)


def annotation_dir(output_dir: Path, name: str) -> Path:
    return output_dir / name


def write_tables(output_dir: Path, spec: DatasetSpec, metrics, coverage) -> None:
    directory = annotation_dir(output_dir, spec.name)
    directory.mkdir(parents=True, exist_ok=True)
    metrics.to_csv(directory / f"{spec.name}_test_metric_rows.csv", index=False)
    coverage.to_csv(directory / f"{spec.name}_test_coverage.csv", index=False)


def read_tables(output_dir: Path, spec: DatasetSpec) -> tuple[pd.DataFrame, pd.DataFrame]:
    directory = annotation_dir(output_dir, spec.name)
    metrics = pd.read_csv(directory / f"{spec.name}_test_metric_rows.csv")
    coverage = pd.read_csv(directory / f"{spec.name}_test_coverage.csv")
    return metrics, coverage


def display_name(name: str) -> str:
    replacements = {
        "cpg": "CpG",
        "ccre": "cCRE",
        "pls": "PLS",
        "pels": "pELS",
        "dels": "dELS",
        "els": "ELS",
        "ca": "CA",
        "ctcf": "CTCF",
        "h3k4me3": "H3K4me3",
        "tf": "TF",
    }
    return " ".join(replacements.get(part, part.capitalize()) for part in name.split("_"))


def draw_title_page(
    pdf: PdfPages,
    spec: DatasetSpec,
    coverage: pd.DataFrame,
    scope_label: str,
) -> None:
    figure, axis = plt.subplots(figsize=(11, 8.5))
    axis.axis("off")
    filtered = int(coverage["filtered_tokens"].sum())
    standard = int(coverage["standard_evaluable_filtered_tokens"].sum())
    lines = [
        f"{display_name(spec.name)}-filtered ordinary TEST report ({len(coverage)} samples)",
        "Standard variability-bin format",
        "",
        f"Saved annotation-overlap tokens: {filtered:,}",
        f"Standard-evaluable filtered tokens: {standard:,}",
        f"Coverage: {standard / filtered:.2%}",
        "",
        f"Filter definition: {spec.rule}.",
        "The saved filtered token keys were used directly; annotation filtering was not repeated.",
        "E1 and E2 were matched to those keys. E10 and E3 came from the saved paired dataset.",
        "Rows were restricted to positions represented in the standard mean-label and variability",
        "resources, matching the reference report pipeline.",
        "Averages use equal participant weight. Whiskers show between-participant standard deviation.",
        "Dotted black line: filtered mean-label baseline. Dotted red line: filtered pretrain-E10 baseline.",
        "",
        "Included samples:",
        *[
            f"  {row.sample}: {row.tissue} ({int(row.standard_evaluable_filtered_tokens):,}/{int(row.filtered_tokens):,})"
            for row in coverage.sort_values(["tissue", "sample"]).itertuples(index=False)
        ],
    ]
    axis.text(0.04, 0.97, "\n".join(lines), va="top", ha="left", fontsize=9.3)
    pdf.savefig(figure)
    plt.close(figure)


def write_report(output_dir: Path, spec: DatasetSpec, metrics, coverage) -> Path:
    directory = annotation_dir(output_dir, spec.name)
    average = aggregate(metrics, ["split", "stage", "prediction_type", "section_rank"])
    tissue = aggregate(
        metrics, ["tissue", "split", "stage", "prediction_type", "section_rank"]
    )
    average.to_csv(directory / f"{spec.name}_test_average_metrics.csv", index=False)
    tissue.to_csv(directory / f"{spec.name}_test_tissue_average_metrics.csv", index=False)
    path = directory / f"{spec.name}_test_weighted_f1_average_and_tissue_report.pdf"
    title = display_name(spec.name)
    with PdfPages(path) as pdf:
        draw_title_page(pdf, spec, coverage)
        draw_result_page(pdf, average, f"{title} filtered test average across {len(coverage)} samples")
        for tissue_name in sorted(tissue["tissue"].unique()):
            rows = tissue.loc[tissue["tissue"].eq(tissue_name)]
            count = int(coverage["tissue"].eq(tissue_name).sum())
            draw_result_page(pdf, rows, f"{title} filtered test {tissue_name} average across {count} samples")
    return path


def create_reports(args, specs: list[DatasetSpec], tasks: list) -> list[Path]:
    task_map = {task.participant: task for task in tasks}
    paths = []
    for spec in specs:
        print(f"analyzing {spec.name}: {spec.rows:,} saved rows", flush=True)
        metrics, coverage = analyze_dataset(
            spec, task_map, args.output_dir / "standard_row_cache", args.chunksize
        )
        write_tables(args.output_dir, spec, metrics, coverage)
        path = write_report(args.output_dir, spec, metrics, coverage)
        paths.append(path)
        print(path.resolve(), flush=True)
    return paths


def rebuild_pdfs(args, specs: list[DatasetSpec]) -> list[Path]:
    paths = []
    for spec in specs:
        metrics, coverage = read_tables(args.output_dir, spec)
        paths.append(write_report(args.output_dir, spec, metrics, coverage))
    return paths


def main() -> None:
    args = parse_args()
    validate_args(args)
    args.output_dir.mkdir(parents=True, exist_ok=True)
    specs = dataset_specs(args.analysis_dir, args.annotations)
    tasks = discover_tasks(args)
    if args.pdf_only:
        paths = rebuild_pdfs(args, specs)
    else:
        if not args.reports_only:
            settings = CacheSettings(
                str(args.output_dir / "standard_row_cache"),
                args.chunksize,
                args.force_cache,
            )
            build_caches(tasks, settings, args.workers)
        if args.cache_only:
            return
        paths = create_reports(args, specs, tasks)
    print("\n".join(str(path.resolve()) for path in paths), flush=True)


if __name__ == "__main__":
    main()
